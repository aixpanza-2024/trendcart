# Ensure the Authorization header always reaches PHP as $_SERVER['HTTP_AUTHORIZATION'].
# Apache (especially on shared hosting) commonly does not pass this through by
# default, which silently breaks Bearer-token auth used by the mobile/API clients.
RewriteEngine On
RewriteCond %{HTTP:Authorization} ^(.+)$
RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

# Never serve git metadata, database dumps or PHP error logs to the public.
# (Plain mod_alias rules, the same override class as RewriteEngine above.)
RedirectMatch 404 /\.git
RedirectMatch 404 \.sql$
RedirectMatch 404 /error_log$

# Uploaded files are images only — never serve (or execute) a script from /uploads/
RedirectMatch 404 (?i)/uploads/.*\.(php[0-9]?|phtml|phar|pht|phps|cgi|pl|py|sh|htaccess)$
