# Composer vendor committed directly (no SSH/terminal on server)
# /vendor/

# SMTP credentials — fill in api/config/email_config.php on the server
api/config/email_config.php

# SMS gateway credentials — copy api/config/sms_config.sample.php on the server
api/config/sms_config.php

# Razorpay API keys — copy api/config/razorpay_config.sample.php on the server
api/config/razorpay_config.php

# Firebase service account (push notifications) — download from Firebase console, never commit
api/config/firebase_service_account.json

# Diagnostic / test scripts — never commit these
test-mail.php

# User uploads — images uploaded by shops/admins at runtime
# Directories are preserved via .gitkeep files for fresh clones
uploads/products/*
!uploads/products/.gitkeep
uploads/shops/*
!uploads/shops/.gitkeep
uploads/banners/*
!uploads/banners/.gitkeep
uploads/categories/*
!uploads/categories/.gitkeep
uploads/super-categories/*
!uploads/super-categories/.gitkeep

# Claude Code local settings
.claude/settings.local.json

# Archive files
*.zip
*.tar.gz

# OS files
.DS_Store
Thumbs.db
api/config/database.php
